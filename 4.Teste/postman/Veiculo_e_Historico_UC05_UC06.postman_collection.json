{
	"info": {
		"_postman_id": "cartoon-veiculo-historico-uc05-uc06",
		"name": "CarToon - Testes de Sistema (UC05 - Manter Veículo & UC06 - Histórico do Veículo)",
		"description": "Suíte de testes de sistema automatizados cobrindo todos os cenários de aceitação de UC05 (Manter Veículo) e UC06 (Consultar Histórico do Veículo).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "UC05 - Manter Veículo",
			"item": [
				{
					"name": "Caso 01: Cadastrar Veículo Válido (Tradicional)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code é 201 Created', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"pm.test('Valida mensagem de sucesso e dados cadastrados', function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json.mensagem).to.eql('Veículo cadastrado com sucesso');",
									"    pm.expect(json.placa).to.eql('XYZ-9876');",
									"    pm.expect(json.montadora).to.eql('Ford');",
									"    pm.expect(json.modelo).to.eql('Ka');",
									"    pm.expect(json.ano).to.eql(2019);",
									"    pm.expect(json.valorFipe).to.eql(35000);",
									"    pm.expect(json.ativo).to.be.true;",
									"    if (json.id) pm.environment.set('veiculoId', json.id);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"clienteId\": {{clienteId}},\n  \"placa\": \"XYZ-9876\",\n  \"montadora\": \"Ford\",\n  \"modelo\": \"Ka\",\n  \"ano\": 2019,\n  \"valorFipe\": 35000.0\n}"
						},
						"url": {
							"raw": "{{baseUrl}}",
							"host": ["{{baseUrl}}"]
						}
					}
				},
				{
