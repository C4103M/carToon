		{
			"name": "UC06 - Consultar Histórico do Veículo",
			"item": [
				{
					"name": "Caso 01: Consultar Histórico por Placa Existente com Ordens",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code é 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Histórico recuperado com sucesso e contém ordens', function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json).to.have.property('veiculo');",
									"    pm.expect(json).to.have.property('ordensServico');",
									"    pm.expect(json.veiculo.placa).to.eql(pm.environment.get('placa'));",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/{{placa}}/historico",
							"host": ["{{baseUrl}}"],
							"path": ["{{placa}}", "historico"]
						}
					}
				},
				{
					"name": "Caso 02: Consultar Histórico de Veículo Sem Histórico",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code é 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Exibe mensagem: Nenhuma ordem de serviço encontrada para este veículo.', function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json.mensagem).to.eql('Nenhuma ordem de serviço encontrada para este veículo.');",
									"    pm.expect(json.ordensServico).to.be.an('array').that.is.empty;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/ABC1D23/historico",
							"host": ["{{baseUrl}}"],
							"path": ["ABC1D23", "historico"]
						}
					}
				},
				{
					"name": "Caso 03: Consultar Histórico por Placa Inexistente",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code é 404 Not Found', function () {",
									"    pm.response.to.have.status(404);",
									"});",
									"pm.test('Exibe mensagem de erro: Veículo não encontrado.', function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json.message).to.eql('Veículo não encontrado.');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/NAO-9999/historico",
							"host": ["{{baseUrl}}"],
							"path": ["NAO-9999", "historico"]
						}
					}
				},
