						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code é 200 OK ou 404 se ID não existir', function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
									"});"
								],
								"type": "text/javascript"
